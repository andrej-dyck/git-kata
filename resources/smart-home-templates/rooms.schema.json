{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Home Rooms",
  "type": "object",
  "required": [
    "rooms"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^[0-9]+.[0-9]+(.[0-9]+)?$"
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
